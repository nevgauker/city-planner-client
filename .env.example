# API Configuration
VITE_API_URL=http://localhost:5000

# Google OAuth 2.0 Client ID (for authentication)
# Get your OAuth 2.0 credentials from: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Web Application credential
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Google Maps API Key (free tier available)
# Get your key from: https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
